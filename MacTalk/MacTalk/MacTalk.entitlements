<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone capture uses AVAudioEngine. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Auto-paste uses NSAppleScript/Apple Events and Accessibility APIs. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!--
	     Whisper's CMake-built dylibs and FluidAudio's package binaries are
	     nested code signed as part of the app build. Keep this exception until
	     every shipped binary is signed by the same Team ID and can be validated
	     without it; allow-jit and unsigned-executable-memory are not needed by
	     the Metal or Parakeet paths and are intentionally absent.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
